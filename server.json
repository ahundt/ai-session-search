{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ahundt/ai-session-search",
  "title": "AI Session Search",
  "description": "Search local AI coding-agent session history from Claude Code, Codex, Gemini CLI, and more.",
