  "packages": [{
    "registryType": "cargo",
    "identifier": "ai-session-search",
    "version": "1.1.0",
    "transport": {"type": "stdio"},
    "packageArguments": [{"type": "positional", "value": "mcp"}, {"type": "positional", "value": "serve"}]
  }]
}
